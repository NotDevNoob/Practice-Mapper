{
  "geode": "5.4.1",
  "gd": {
    "win": "*"
  },
  "version": "1.1.0",
  "id": "notdevnoob.practice-mapper",
  "name": "Practice Mapper",
  "developer": "NotDevNoob",
  "description": "Adds a layout-aware Practice button for approved mappings, lets players browse and submit new practice mappings in-game, and reads approved mappings from configurable GitHub storage with optional API fallback.",
  "links": {
    "community": "https://discord.gg/EG4s6VuuTE",
    "source": "https://github.com/NotDevNoob/Practice-Mapper"
  },
  "repository": "https://github.com/NotDevNoob/Practice-Mapper",
  "issues": {
    "info": "Need help, want to submit mappings, or want to report a broken one? Join the <cp>Practice Mapper Discord</c> or open a GitHub issue.",
    "url": "https://github.com/NotDevNoob/Practice-Mapper/issues/new"
  },
  "resources": {
    "files": [
      "support.md"
    ]
  },
  "tags": ["online", "utility", "interface"],
  "settings": {
    "github-repository": {
      "type": "string",
      "name": "GitHub Repository",
      "description": "Repository in owner/repo form used for approved mappings when the override URL is empty.",
      "default": "NotDevNoob/gd-level-mappings"
    },
    "github-branch": {
      "type": "string",
      "name": "GitHub Branch",
      "description": "Branch used for approved mappings when the override URL is empty.",
      "default": "main"
    },
    "github-json-path": {
      "type": "string",
      "name": "GitHub JSON Path",
      "description": "Path to the approved mappings JSON file inside the GitHub repository.",
      "default": "mappings.json"
    },
    "approved-mappings-url": {
      "type": "string",
      "name": "Approved Mappings URL",
      "description": "Advanced override. Leave empty to build the raw GitHub URL from the repository, branch, and JSON path settings.",
      "default": ""
    },
    "api-base-url": {
      "type": "string",
      "name": "API Base URL",
      "description": "Optional API used for fallback lookups and in-game mapping submissions.",
      "default": ""
    }
  }
}
