{
  "geode": "5.4.1",
  "gd": {
    "win": "*"
  },
  "version": "1.2.0",
  "id": "notdevnoob.practice-mapper",
  "name": "Practice Mapper",
  "developer": "NotDevNoob",
  "description": "Adds a small Practice button to online levels so approved practice copies can be opened quickly, and lets players submit missing mappings in-game.",
  "links": {
    "community": "https://discord.gg/EG4s6VuuTE",
    "source": "https://github.com/NotDevNoob/Practice-Mapper"
  },
  "repository": "https://github.com/NotDevNoob/Practice-Mapper",
  "issues": {
    "info": "Need help, want to submit mappings, or found a broken one? Join the <cp>Practice Mapper Discord</c>.",
    "url": "https://github.com/NotDevNoob/Practice-Mapper/issues/new"
  },
  "resources": {
    "files": [
      "support.md"
    ]
  },
  "tags": ["online", "utility", "interface"],
  "settings": {
    "github-repository": {
      "type": "string",
      "name": "GitHub Repository",
      "description": "Repository in owner/repo form for approved mappings. Most players can leave this alone.",
      "default": "NotDevNoob/gd-level-mappings"
    },
    "github-branch": {
      "type": "string",
      "name": "GitHub Branch",
      "description": "Branch for approved mappings. Most players can leave this alone.",
      "default": "main"
    },
    "github-json-path": {
      "type": "string",
      "name": "GitHub JSON Path",
      "description": "Path to the approved mappings JSON file inside the repository.",
      "default": "mappings.json"
    },
    "approved-mappings-url": {
      "type": "string",
      "name": "Approved Mappings URL",
      "description": "Optional direct link to an approved mappings JSON file.",
      "default": ""
    },
    "api-base-url": {
      "type": "string",
      "name": "API Base URL",
      "description": "Only needed for in-game submissions and Discord review.",
      "default": ""
    }
  }
}
